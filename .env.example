# Copiá estos nombres en Vercel → Settings → Environment Variables.
# Los valores salen de Supabase → Project Settings → API (y Database para DATABASE_URL).

# Dirección del proyecto de Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública "anon" (pública: las reglas de la base de datos protegen los datos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio "service_role": SECRETA, solo servidor. Se usa para borrar cuentas.
SUPABASE_SERVICE_ROLE_KEY=

# Conexión a la base de datos (Session pooler). SECRETA. Crea las tablas al publicar.
DATABASE_URL=

# Dirección pública de PaludIA, sin barra final (ej: https://paludia.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Botón de Google: poné "on" solo cuando Google esté configurado en Supabase
NEXT_PUBLIC_AUTH_GOOGLE=off
